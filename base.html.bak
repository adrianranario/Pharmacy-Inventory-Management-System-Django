<!DOCTYPE html>
{% load static %}
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Pharmacy IMS{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230f172a'/%3E%3Cpath d='M16 9v14M9 16h14' stroke='%23fff' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
    <!-- Fonts and Icons - local/system fallbacks for offline use -->
    <style>
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 400 700;
            font-display: swap;
            src: local('Inter'), local('Segoe UI'), local('Roboto'), local('Arial');
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Tailwind CSS (local fallback if CDN unavailable) -->
    <script src="{% static 'vendor/tailwind/tailwind.js' %}" onerror="this.remove();"></script>
    <script>
        if (typeof tailwind !== 'undefined') {
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
                        },
                        colors: {
                            border: 'hsl(var(--border))',
                            input: 'hsl(var(--input))',
                            ring: 'hsl(var(--ring))',
                            background: 'hsl(var(--background))',
                            foreground: 'hsl(var(--foreground))',
                            primary: {
                                DEFAULT: 'hsl(var(--primary))',
                                foreground: 'hsl(var(--primary-foreground))',
                            },
                            secondary: {
                                DEFAULT: 'hsl(var(--secondary))',
                                foreground: 'hsl(var(--secondary-foreground))',
                            },
                            destructive: {
                                DEFAULT: 'hsl(var(--destructive))',
                                foreground: 'hsl(var(--destructive-foreground))',
                            },
                            muted: {
                                DEFAULT: 'hsl(var(--muted))',
                                foreground: 'hsl(var(--muted-foreground))',
                            },
                            accent: {
                                DEFAULT: 'hsl(var(--accent))',
                                foreground: 'hsl(var(--accent-foreground))',
                            },
                            popover: {
                                DEFAULT: 'hsl(var(--popover))',
                                foreground: 'hsl(var(--popover-foreground))',
                            },
                            card: {
                                DEFAULT: 'hsl(var(--card))',
                                foreground: 'hsl(var(--card-foreground))',
                            },
                        },
                        borderRadius: {
                            lg: 'var(--radius)',
                            md: 'calc(var(--radius) - 2px)',
                            sm: 'calc(var(--radius) - 4px)',
                        },
                    },
                },
            }
        }
    </script>
    <link rel="stylesheet" href="{% static 'css/app.css' %}">
    {% block extra_css %}{% endblock %}
</head>
<body class="min-h-screen bg-background text-foreground antialiased">
    {% if user.is_authenticated %}
    <div class="min-h-screen">
        <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-border bg-card md:flex">
            <div class="flex h-16 flex-none items-center gap-3 border-b border-border px-5">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                    <i class="bi bi-capsule-pill"></i>
                </div>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold leading-tight">Pharmacy IMS</p>
                    <p class="truncate text-xs text-muted-foreground">Inventory management</p>
                </div>
            </div>

            <div class="scrollbar-thin flex-1 overflow-y-auto px-3 py-4">
                <p class="nav-section">Overview</p>
                <nav class="space-y-0.5">
                    <a href="{% url 'dashboard' %}" class="nav-link {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </nav>

                <p class="nav-section mt-4">Operations</p>
                <nav class="space-y-0.5">
                    {% if nav_perms.sell %}
                    <a href="{% url 'pos_index' %}" class="nav-link {% if request.resolver_match.url_name == 'pos_index' %}active{% endif %}">
                        <i class="bi bi-cart-check"></i>
                        <span>POS</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.manage_purchases %}
                    <a href="{% url 'purchase_list' %}" class="nav-link {% if request.resolver_match.url_name == 'purchase_list' or request.resolver_match.url_name == 'purchase_add' or request.resolver_match.url_name == 'purchase_view' %}active{% endif %}">
                        <i class="bi bi-bag-plus"></i>
                        <span>Purchases</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.view_sales %}
                    <a href="{% url 'sales_list' %}" class="nav-link {% if request.resolver_match.url_name == 'sales_list' or request.resolver_match.url_name == 'sale_view' or request.resolver_match.url_name == 'sale_return' %}active{% endif %}">
                        <i class="bi bi-receipt"></i>
                        <span>Sales</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.manage_inventory %}
                    <a href="{% url 'inventory_list' %}" class="nav-link {% if request.resolver_match.url_name == 'inventory_list' or request.resolver_match.url_name == 'adjust_stock' or request.resolver_match.url_name == 'write_off_batch' %}active{% endif %}">
                        <i class="bi bi-box-seam"></i>
                        <span>Inventory</span>
                    </a>
                    <a href="{% url 'stock_movements' %}" class="nav-link {% if request.resolver_match.url_name == 'stock_movements' %}active{% endif %}">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Stock ledger</span>
                    </a>
                    <a href="{% url 'alerts' %}" class="nav-link {% if request.resolver_match.url_name == 'alerts' %}active{% endif %}">
                        <i class="bi bi-bell"></i>
                        <span>Alerts</span>
                        {% if alert_counts.total %}
                        <span class="badge badge-destructive ml-auto">{{ alert_counts.total }}</span>
                        {% endif %}
                    </a>
                    {% endif %}
                </nav>

                {% if nav_perms.manage_inventory %}
                <p class="nav-section mt-4">Catalog</p>
                <nav class="space-y-0.5">
                    <a href="{% url 'medicine_list' %}" class="nav-link {% if request.resolver_match.url_name == 'medicine_list' or request.resolver_match.url_name == 'medicine_add' or request.resolver_match.url_name == 'medicine_edit' %}active{% endif %}">
                        <i class="bi bi-capsule"></i>
                        <span>Medicines</span>
                    </a>
                    <a href="{% url 'category_list' %}" class="nav-link {% if request.resolver_match.url_name == 'category_list' or request.resolver_match.url_name == 'category_add' or request.resolver_match.url_name == 'category_edit' %}active{% endif %}">
                        <i class="bi bi-tags"></i>
                        <span>Categories</span>
                    </a>
                    <a href="{% url 'supplier_list' %}" class="nav-link {% if request.resolver_match.url_name == 'supplier_list' or request.resolver_match.url_name == 'supplier_add' or request.resolver_match.url_name == 'supplier_edit' %}active{% endif %}">
                        <i class="bi bi-truck"></i>
                        <span>Suppliers</span>
                    </a>
                </nav>
                {% endif %}

                {% if nav_perms.view_customers %}
                <p class="nav-section mt-4">Customers</p>
                <nav class="space-y-0.5">
                    <a href="{% url 'customer_list' %}" class="nav-link {% if request.resolver_match.url_name == 'customer_list' or request.resolver_match.url_name == 'customer_add' or request.resolver_match.url_name == 'customer_edit' or request.resolver_match.url_name == 'customer_detail' %}active{% endif %}">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                    {% if nav_perms.manage_prescriptions %}
                    <a href="{% url 'prescription_list' %}" class="nav-link {% if request.resolver_match.url_name == 'prescription_list' or request.resolver_match.url_name == 'prescription_add' or request.resolver_match.url_name == 'prescription_edit' %}active{% endif %}">
                        <i class="bi bi-file-medical"></i>
                        <span>Prescriptions</span>
                    </a>
                    {% endif %}
                </nav>
                {% endif %}

                {% if nav_perms.view_reports or nav_perms.use_assistant %}
                <p class="nav-section mt-4">Insights</p>
                <nav class="space-y-0.5">
                    {% if nav_perms.view_reports %}
                    <a href="{% url 'forecast_index' %}" class="nav-link {% if request.resolver_match.url_name == 'forecast_index' %}active{% endif %}">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Forecasting</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.use_assistant %}
                    <a href="{% url 'assistant_index' %}" class="nav-link {% if request.resolver_match.url_name == 'assistant_index' %}active{% endif %}">
                        <i class="bi bi-robot"></i>
                        <span>AI Assistant</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.view_reports %}
                    <a href="{% url 'reports_index' %}" class="nav-link {% if request.resolver_match.url_name == 'reports_index' or request.resolver_match.url_name == 'report_inventory' or request.resolver_match.url_name == 'report_low_stock' or request.resolver_match.url_name == 'report_near_expiry' or request.resolver_match.url_name == 'report_sales' or request.resolver_match.url_name == 'report_purchases' %}active{% endif %}">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>Reports</span>
                    </a>
                    {% endif %}
                </nav>
                {% endif %}

                {% if nav_perms.manage_users or nav_perms.view_audit %}
                <p class="nav-section mt-4">Administration</p>
                <nav class="space-y-0.5">
                    {% if nav_perms.manage_users %}
                    <a href="{% url 'user_list' %}" class="nav-link {% if request.resolver_match.url_name == 'user_list' or request.resolver_match.url_name == 'user_add' or request.resolver_match.url_name == 'user_edit' or request.resolver_match.url_name == 'user_delete' %}active{% endif %}">
                        <i class="bi bi-person-badge"></i>
                        <span>Users</span>
                    </a>
                    {% endif %}
                    {% if nav_perms.view_audit %}
                    <a href="{% url 'audit_log' %}" class="nav-link {% if request.resolver_match.url_name == 'audit_log' %}active{% endif %}">
                        <i class="bi bi-journal-text"></i>
                        <span>Audit log</span>
                    </a>
                    {% endif %}
                </nav>
                {% endif %}
            </div>

            <div class="flex-none border-t border-border p-3">
                <div class="flex items-center gap-3 rounded-lg px-2 py-2">
                    <div class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-secondary text-sm font-semibold text-secondary-foreground">
                        {{ user.username|slice:":1"|upper }}
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium leading-tight">{{ user.get_full_name|default:user.username }}</p>
                        <p class="truncate text-xs text-muted-foreground">{{ user.get_role_display }}</p>
                    </div>
                    <a href="{% url 'security_settings' %}" class="btn btn-ghost btn-icon btn-sm text-muted-foreground" title="Security" aria-label="Security settings">
                        <i class="bi bi-shield-lock"></i>
                    </a>
                    <form method="post" action="{% url 'logout' %}" class="flex">
                        {% csrf_token %}
                        <button type="submit" class="btn btn-ghost btn-icon btn-sm text-muted-foreground" title="Sign out" aria-label="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="flex min-h-screen flex-col md:pl-64">
            <header class="sticky top-0 z-30 flex h-16 flex-none items-center gap-3 border-b border-border bg-background/95 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/80 sm:px-6">
                <a href="{% url 'dashboard' %}" class="flex items-center gap-2 md:hidden">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                        <i class="bi bi-capsule-pill text-sm"></i>
                    </span>
                    <span class="text-sm font-semibold">Pharmacy IMS</span>
                </a>

                <nav class="hidden items-center gap-1.5 text-sm text-muted-foreground md:flex" aria-label="Breadcrumb">
                    <a href="{% url 'dashboard' %}" class="inline-flex items-center gap-1 transition-colors hover:text-foreground">
                        <i class="bi bi-house text-xs"></i>
                        <span>Home</span>
                    </a>
                    {% block breadcrumbs %}{% endblock %}
                </nav>

                <div class="ml-auto flex items-center gap-2">
                    <span class="hidden items-center gap-2 rounded-md border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground sm:inline-flex">
                        <i class="bi bi-calendar3"></i>
                        <span>{% now "l, F d, Y" %}</span>
                    </span>

                    <div class="hidden items-center gap-2 rounded-md border border-border bg-card py-1 pl-1 pr-3 lg:flex">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-secondary text-xs font-semibold text-secondary-foreground">
                            {{ user.username|slice:":1"|upper }}
                        </span>
                        <span class="text-xs font-medium">{{ user.get_full_name|default:user.username }}</span>
                    </div>

                    <details class="relative md:hidden">
                        <summary class="btn btn-outline btn-sm cursor-pointer list-none">
                            <i class="bi bi-list text-base"></i>
                            <span>Menu</span>
                        </summary>
                        <div class="absolute right-0 z-50 mt-2 max-h-[calc(100vh-5rem)] w-60 overflow-y-auto rounded-lg border border-border bg-popover p-1 shadow-lg">
                            <a href="{% url 'dashboard' %}" class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                            {% if nav_perms.sell %}<a href="{% url 'pos_index' %}" class="nav-link"><i class="bi bi-cart-check"></i><span>POS</span></a>{% endif %}
                            {% if nav_perms.manage_purchases %}<a href="{% url 'purchase_list' %}" class="nav-link"><i class="bi bi-bag-plus"></i><span>Purchases</span></a>{% endif %}
                            {% if nav_perms.view_sales %}<a href="{% url 'sales_list' %}" class="nav-link"><i class="bi bi-receipt"></i><span>Sales</span></a>{% endif %}
                            {% if nav_perms.manage_inventory %}
                            <a href="{% url 'inventory_list' %}" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventory</span></a>
                            <a href="{% url 'stock_movements' %}" class="nav-link"><i class="bi bi-arrow-left-right"></i><span>Stock ledger</span></a>
                            <a href="{% url 'alerts' %}" class="nav-link"><i class="bi bi-bell"></i><span>Alerts</span>{% if alert_counts.total %}<span class="badge badge-destructive ml-auto">{{ alert_counts.total }}</span>{% endif %}</a>
                            <a href="{% url 'medicine_list' %}" class="nav-link"><i class="bi bi-capsule"></i><span>Medicines</span></a>
                            <a href="{% url 'category_list' %}" class="nav-link"><i class="bi bi-tags"></i><span>Categories</span></a>
                            <a href="{% url 'supplier_list' %}" class="nav-link"><i class="bi bi-truck"></i><span>Suppliers</span></a>
                            {% endif %}
                            {% if nav_perms.view_customers %}<a href="{% url 'customer_list' %}" class="nav-link"><i class="bi bi-people"></i><span>Customers</span></a>{% endif %}
                            {% if nav_perms.manage_prescriptions %}<a href="{% url 'prescription_list' %}" class="nav-link"><i class="bi bi-file-medical"></i><span>Prescriptions</span></a>{% endif %}
                            {% if nav_perms.view_reports %}<a href="{% url 'forecast_index' %}" class="nav-link"><i class="bi bi-graph-up-arrow"></i><span>Forecasting</span></a>{% endif %}
                            {% if nav_perms.use_assistant %}<a href="{% url 'assistant_index' %}" class="nav-link"><i class="bi bi-robot"></i><span>AI Assistant</span></a>{% endif %}
                            {% if nav_perms.view_reports %}<a href="{% url 'reports_index' %}" class="nav-link"><i class="bi bi-file-earmark-bar-graph"></i><span>Reports</span></a>{% endif %}
                            {% if nav_perms.manage_users %}<a href="{% url 'user_list' %}" class="nav-link"><i class="bi bi-person-badge"></i><span>Users</span></a>{% endif %}
                            {% if nav_perms.view_audit %}<a href="{% url 'audit_log' %}" class="nav-link"><i class="bi bi-journal-text"></i><span>Audit log</span></a>{% endif %}
                            <div class="my-1 h-px bg-border"></div>
                            <a href="{% url 'security_settings' %}" class="nav-link"><i class="bi bi-shield-lock"></i><span>Security</span></a>
                            <form method="post" action="{% url 'logout' %}">
                                {% csrf_token %}
                                <button type="submit" class="nav-link w-full cursor-pointer"><i class="bi bi-box-arrow-right"></i><span>Sign out</span></button>
                            </form>
                        </div>
                    </details>
                </div>
            </header>

            <main class="flex-1">
                <div class="w-full px-4 py-4 sm:px-6">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <h1 class="text-2xl font-semibold tracking-tight text-foreground">{% block page_title %}Dashboard{% endblock %}</h1>
                            <p class="mt-1 text-sm text-muted-foreground">{% block page_subtitle %}Pharmacy Inventory Management System{% endblock %}</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            {% block page_actions %}{% endblock %}
                        </div>
                    </div>

                    {% if messages %}
                    <div class="mt-6 space-y-3">
                        {% for message in messages %}
                        <div class="alert {% if message.tags == 'success' %}alert-success{% elif message.tags == 'error' or message.tags == 'danger' %}alert-destructive{% elif message.tags == 'warning' %}alert-warning{% else %}alert-info{% endif %}" role="alert">
                            <i class="bi {% if message.tags == 'success' %}bi-check-circle{% elif message.tags == 'error' or message.tags == 'danger' %}bi-exclamation-octagon{% elif message.tags == 'warning' %}bi-exclamation-triangle{% else %}bi-info-circle{% endif %}"></i>
                            <span class="flex-1">{{ message }}</span>
                            <button type="button" class="rounded-md p-1 opacity-70 transition hover:bg-black/5 hover:opacity-100" onclick="this.parentElement.remove()" aria-label="Dismiss">
                                <i class="bi bi-x-lg text-xs"></i>
                            </button>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    <div class="mt-6">
                        {% block content %}{% endblock %}
                    </div>
                </div>
            </main>
        </div>
    </div>
    {% else %}
    <main class="min-h-screen">
        {% block auth_content %}{% endblock %}
    </main>
    {% endif %}
    {% block extra_js %}{% endblock %}
</body>
</html>
