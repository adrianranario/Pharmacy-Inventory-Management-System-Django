# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Generate a new key for production, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (leave DB_ENGINE empty to use the bundled SQLite database)
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pharmacy
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Sessions and transport security
# ---------------------------------------------------------------------------
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Email (password reset and scheduled stock alerts)
# The backend is selected automatically: SMTP when EMAIL_HOST_PASSWORD is set,
# console otherwise. Uncomment the line below to force a specific backend.
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pharmacy IMS <no-reply@pharmacy.local>
ALERT_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Pharmacy profile and compliance
# ---------------------------------------------------------------------------
PHARMACY_NAME=Pharmacy IMS
PHARMACY_ADDRESS=123 Rizal Avenue, Manila
PHARMACY_TIN=000-000-000-000
VAT_RATE=12
SENIOR_DISCOUNT_RATE=20
EXPIRY_WARNING_DAYS=90

# ---------------------------------------------------------------------------
# Two-factor authentication (TOTP)
# ---------------------------------------------------------------------------
OTP_ISSUER=Pharmacy IMS
OTP_VALID_WINDOW=1

# ---------------------------------------------------------------------------
# AI assistant (optional)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
